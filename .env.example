# Keep secrets in Vercel project environment variables in production.
TMDB_API_KEY=
TMDB_DISCOVER_LANGUAGE=en-US
TMDB_REGION=US
TMDB_SORT_BY=popularity.desc
TMDB_INCLUDE_ADULT=false
TMDB_MAX_MOVIES=25
TMDB_MAX_SERIES=10
TMDB_LATEST_LOOKBACK_MONTHS=1
ANISUGE_API_BASE=https://anisuge-api.vercel.app/api
CORS_ORIGINS=https://vibbletv.blogspot.com,https://www.vibbletv.blogspot.com
